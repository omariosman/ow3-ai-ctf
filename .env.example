# Copy to .env and adjust as needed. No secrets are required for local use.
# The challenge flag is generated at runtime and stored server-side only.

# Backend environment: "development" enables /docs and verbose config.
# Use anything else (e.g. "production") for a hardened, docs-disabled mode.
CTF_ENVIRONMENT=development

# Backend database (SQLite by default). The Docker setup overrides this to a
# path on the mounted volume.
# CTF_DATABASE_URL=sqlite:////data/ctf.db

# Comma-separated list of browser origins allowed to call the backend.
CTF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limit for the inference oracle (requests/window).
CTF_PREDICT_RATE_LIMIT=120/minute

# Frontend -> backend URL used by the browser. For Docker this is the
# host-exposed backend port.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Release Roulette agent planner. "mock" (deterministic, offline) is the default
# and currently the only supported value.
# RELEASE_ROULETTE_LLM_PROVIDER=mock
